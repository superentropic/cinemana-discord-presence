{
  "manifest_version": 3,
  "name": "Cinemana Discord Presence",
  "version": "1.0.0",
  "description": "Sends the current Cinemana playback status to a local Discord Rich Presence bridge.",
  "content_scripts": [{
    "matches": ["https://cinemana.shabakaty.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://127.0.0.1/*"]
}
